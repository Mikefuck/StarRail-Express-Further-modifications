{
    "schemaVersion": 1,
    "id": "habitrain_core",
    "version": "${version}",
    "name": "哈比列车核心 (HabiTrain Core)",
    "description": "哈比列车游戏框架与任务系统API模组",
    "authors": ["HabiTrain"],
    "contact": { "homepage": "https://github.com/" },
    "license": "MIT",
    "icon": "assets/habitrain_core/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.habitrain.core.HabiTrainCore"],
        "client": ["com.habitrain.core.client.HabiTrainCoreClient"],
        "modmenu": ["com.habitrain.core.client.gui.ModMenuIntegration"],
        "cardinal-components": ["com.habitrain.core.game.sre.role.HabiComponents"]
    },
    "custom": {
        "cardinal-components": [
            "habitrain_core:crime_scapegoat",
            "habitrain_core:flower_girl",
            "habitrain_core:swift_wind",
            "habitrain_core:mime_killer",
            "habitrain_core:sin_pride",
            "habitrain_core:sin_envy",
            "habitrain_core:sin_wrath",
            "habitrain_core:sin_greed",
            "habitrain_core:sin_gluttony",
            "habitrain_core:sin_lust",
            "habitrain_core:sin_sloth"
        ]
    },
    "mixins": [
        "habitrain_core.mixins.json",
        { "config": "habitrain_core.client.mixins.json", "environment": "client" }
    ],
    "depends": {
        "fabricloader": ">=0.19.2",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*",
        "starrailexpress": "*",
        "modmenu": "*",
        "betel-nut-mod": "*"
    }
}
